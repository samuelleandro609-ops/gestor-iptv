# Copie estas variáveis para as Environment Variables do serviço no Render.
# NUNCA cole valores reais em arquivos do projeto nem em chats.
# Tokens do Mercado Pago e senhas de painel NÃO vão aqui: eles continuam
# salvos dentro do gestor, nas abas próprias, como no gestor original.
NODE_ENV=production
# Endereço público do seu serviço (o Render mostra na página do serviço):
PUBLIC_BASE_URL=https://SEU-SERVICO.onrender.com
# URL do banco Postgres criado no Render (o painel preenche sozinho
# quando o banco é ligado ao serviço pelo render.yaml):
DATABASE_URL=<preenchido-pelo-render>
# Chave de sessão: deixe o Render gerar (generateValue no render.yaml).
SESSION_SECRET=<gerado-pelo-render>
# Somente para rodar local sem Postgres (opcional; sem DATABASE_URL o
# servidor usa o Postgres embarcado PGlite nesta pasta):
# PGLITE_DATA_DIR=./data/pglite
# Pasta das sessões do WhatsApp (opcional):
# GESTOR_DATA_DIR=./.gestor-data
