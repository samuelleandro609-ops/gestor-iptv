{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-jsx",
    "types": [
      "bun-types",
      "react",
      "react-dom"
    ],
    "rootDir": "..",
    "tsBuildInfoFile": "./.tsbuildinfo.client",
    "noImplicitAny": false
  },
  "include": [
    "src/**/*",
    "../server/src/**/*"
  ]
}
